{
  "name": "small-web",
  "version": "1.0.0",
  "description": "The Small Web - The sites and the browser you read them in",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"cyan,magenta\" \"pnpm --filter small-web-backend start:dev\" \"pnpm --filter small-web-frontend dev\"",
    "dev:backend": "pnpm --filter small-web-backend start:dev",
    "dev:frontend": "pnpm --filter small-web-frontend dev",
    "seed": "pnpm --filter small-web-backend seed",
    "build": "pnpm --filter small-web-backend build && pnpm --filter small-web-frontend build",
    "start": "concurrently -n \"backend,frontend\" -c \"cyan,magenta\" \"pnpm --filter small-web-backend start:prod\" \"pnpm --filter small-web-frontend start\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
